---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// DATOS DE CANTERA
const modelos = [
  {
    id: "granito-pb",
    nombre: "Depto. Modelo Granito",
    precio: "Desde $1,010,500",
    construccion: "57.65 m²",
    terreno: "N/A",
    recamaras: 2,
    banos: 1,
    estacionamiento: 1,
    descripcion: "Departamento con distribución eficiente y alta demanda. Excelente opción para inversión y patrimonio. Disponibilidad limitada.",
    ubicacion: "Cerrada Mina Mza. 1 Lt. 2 S/N, Cantera Chalco.",
    creditos: ["Infonavit", "Fovissste", "Bancario"],
    tourVirtual: "#", // Si tienes link, ponlo aquí
    imagen: "/cantera/departamento-modelo-granito-cantera.jpg", // Asegúrate de tener esta foto
    preciosPorNivel: [
      { nivel: "Planta Baja", precio: "$1,168,500" },
      { nivel: "Nivel 1", precio: "$1,035,200" },
      { nivel: "Nivel 2", precio: "$1,011,500" },
      { nivel: "Nivel 3", precio: "$1,010,500" }
    ]
  }
];

// ICONOS
const iconArea = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0L21.3 15.3z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></svg>`;
const iconBed = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>`;
const iconBath = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><line x1="10" x2="8" y1="5" y2="7"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="7" x2="7" y1="19" y2="21"/><line x1="17" x2="17" y1="19" y2="21"/></svg>`;
const iconCar = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>`;
const iconPin = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
const iconCredit = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`;
---

<Layout title="Cantera - Nuevo Proyecto 2026">
    <Header />
    
    <section class="relative pt-40 pb-20 bg-stone-900 text-white overflow-hidden">
        <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/concrete-wall.png')]"></div>
        <div class="container mx-auto px-4 relative z-10 text-center" data-aos="fade-down">
            <span class="text-[#C0B295] font-bold tracking-widest uppercase mb-4 block">Nuevo Proyecto 2026</span>
            <h1 class="text-4xl md:text-6xl font-extrabold mb-6">Cantera Chalco</h1>
            <p class="text-xl text-stone-200 max-w-3xl mx-auto font-light leading-relaxed">
                Una oportunidad estratégica de inversión. Plusvalía, seguridad y calidad constructiva respaldada por <strong class="text-white">Grupo Sadasi</strong>.
            </p>
        </div>
    </section>

    <main class="bg-stone-50 py-20">
        <div class="container mx-auto px-4 space-y-24">
            
            {modelos.map((casa, index) => (
                <div class="flex flex-col lg:flex-row items-start gap-12" data-aos="fade-up">
                    
                    <div class="lg:w-1/2 w-full relative group lg:sticky lg:top-32">
                        <div class="absolute inset-0 bg-[#C0B295] rounded-3xl transform translate-x-3 translate-y-3 transition-transform group-hover:translate-x-2 group-hover:translate-y-2"></div>
                        <div class="relative rounded-3xl overflow-hidden shadow-2xl h-[450px]">
                            <img 
                                src={casa.imagen} 
                                alt={casa.nombre} 
                                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                            />
                            <div class="absolute top-6 right-6 bg-white/95 backdrop-blur px-4 py-2 rounded-full shadow-lg border-l-4 border-[#C0B295]">
                                <span class="block text-xs text-stone-500 uppercase font-bold tracking-wider">Entrega</span>
                                <span class="text-lg font-extrabold text-[#776E63]">INMEDIATA</span>
                            </div>
                        </div>
                    </div>

                    <div class="lg:w-1/2 w-full space-y-8">
                        <div>
                            <h2 class="text-4xl font-bold text-[#776E63]">{casa.nombre}</h2>
                            <div class="w-20 h-1.5 bg-[#C0B295] rounded-full mt-4"></div>
                        </div>
                        
                        <p class="text-stone-600 text-lg leading-relaxed">
                            {casa.descripcion}
                        </p>

                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-stone-200">
                                <div class="text-[#776E63] mb-2 flex justify-center" set:html={iconArea}></div>
                                <span class="text-sm font-bold text-stone-600">{casa.construccion}</span>
                            </div>
                            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-stone-200">
                                <div class="text-[#776E63] mb-2 flex justify-center" set:html={iconBed}></div>
                                <span class="text-sm font-bold text-stone-600">{casa.recamaras} Rec.</span>
                            </div>
                            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-stone-200">
                                <div class="text-[#776E63] mb-2 flex justify-center" set:html={iconBath}></div>
                                <span class="text-sm font-bold text-stone-600">{casa.banos} Baños</span>
                            </div>
                            <div class="text-center p-4 bg-white rounded-xl shadow-sm border border-stone-200">
                                <div class="text-[#776E63] mb-2 flex justify-center" set:html={iconCar}></div>
                                <span class="text-sm font-bold text-stone-600">{casa.estacionamiento} Auto</span>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border border-stone-200 overflow-hidden shadow-sm">
                            <div class="bg-stone-100 px-6 py-3 border-b border-stone-200">
                                <h3 class="font-bold text-stone-700">Precios por Nivel</h3>
                            </div>
                            <div class="divide-y divide-stone-100">
                                {casa.preciosPorNivel.map((nivel) => (
                                    <div class="flex justify-between px-6 py-3 hover:bg-stone-50 transition">
                                        <span class="text-stone-600 font-medium">{nivel.nivel}</span>
                                        <span class="text-[#C0B295] font-bold">{nivel.precio}</span>
                                    </div>
                                ))}
                            </div>
                            <div class="px-6 py-2 bg-stone-50 text-xs text-stone-400 italic text-center">
                                *Sujeto a disponibilidad y cambios sin previo aviso.
                            </div>
                        </div>

                        <div class="bg-stone-100 p-5 rounded-xl border border-stone-200 space-y-3">
                            <div class="flex items-start gap-3">
                                <div class="text-[#C0B295] mt-0.5" set:html={iconPin}></div>
                                <p class="text-sm text-stone-600">
                                    <strong class="text-stone-800 block">Ubicación:</strong> 
                                    {casa.ubicacion}
                                </p>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="text-[#C0B295] mt-0.5" set:html={iconCredit}></div>
                                <p class="text-sm text-stone-600">
                                    <strong class="text-stone-800 block">Créditos:</strong> 
                                    {casa.creditos.join(', ')}.
                                </p>
                            </div>
                        </div>

                        <a 
                            href="/#agenda" 
                            class="block w-full bg-[#776E63] text-white text-center py-4 rounded-xl font-bold hover:bg-[#5d554c] transition shadow-lg hover:shadow-stone-900/20"
                        >
                            Agendar Visita en Cantera
                        </a>
                    </div>

                </div>
            ))}

        </div>
    </main>

    <Footer />
</Layout>